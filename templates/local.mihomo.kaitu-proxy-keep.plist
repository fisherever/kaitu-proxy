<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User-level LaunchAgent: every 120s, keep Kaitu in proxy mode.

  Install:
    cp local.mihomo.kaitu-proxy-keep.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.mihomo.kaitu-proxy-keep.plist

  __HOME__ is a placeholder — launchd expands neither $HOME nor ~.
  Expand it before installing:  sed "s|__HOME__|$HOME|g" local.mihomo.kaitu-proxy-keep.plist > /tmp/local.mihomo.kaitu-proxy-keep.plist

  The script itself checks whether the mihomo process is running, and exits immediately if
  it is missing.
-->
<plist version="1.0"><dict>
  <key>Label</key><string>local.mihomo.kaitu-proxy-keep</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__HOME__/.config/mihomo-tun/kaitu-proxy-keep.sh</string></array>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
</dict></plist>
