<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Root LaunchDaemon: runs start-b.sh (launchd supervises the script; the script starts mihomo)

  Install:
    sudo cp local.mihomo.k2b.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/local.mihomo.k2b.plist
    sudo chmod 644 /Library/LaunchDaemons/local.mihomo.k2b.plist
    sudo launchctl bootstrap system /Library/LaunchDaemons/local.mihomo.k2b.plist

  Restart after editing start-b.sh:
    sudo launchctl kickstart -k system/local.mihomo.k2b

  Note: __HOME__ is a placeholder — launchd expands neither $HOME nor ~.
  Expand it before installing:  sed "s|__HOME__|$HOME|g" local.mihomo.k2b.plist > /tmp/local.mihomo.k2b.plist
  Also change the Label per device.
-->
<plist version="1.0"><dict>
  <key>Label</key><string>local.mihomo.k2b</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>__HOME__/.config/mihomo-tun/start-b.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__HOME__/.config/mihomo-tun/daemon.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.config/mihomo-tun/daemon.err</string>
</dict></plist>
